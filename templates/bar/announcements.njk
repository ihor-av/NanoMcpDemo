<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <title>Оголошення — bar.ch.gov.ua</title>
</head>
<body>
  <h1>Оголошення</h1>

  <main>
    {% for item in announcements %}
    <div class="news-card">
      <h3 class="news-title"><a href="/announcements/{{ item.id }}">{{ item.title }}</a></h3>
      <span class="news-date">{{ item.date }}</span>
      <p>{{ item.summary }}</p>
    </div>
    {% endfor %}
  </main>
</body>
</html>
